// "ice_bolt.bitmaps"  The chilling bolt fired by the Cryo Ray.  A cyan/white
// recolor of the Laser beam.  On hitting a Creature it does light damage but
// stuns it for a good long while -- see IceBolt::collide() in actual.cpp.


#if X11
#include "gen_xpm/ice_bolt/ice_bolt_25.xpm"
#include "gen_xpm/ice_bolt/ice_bolt_28.xpm"
#endif



#define ICE_BOLT_STUN_TIME 90



Size IceBolt::get_size(Dir dir) {
  return context.movingContext.sizes[dir];
}



Size IceBolt::get_size_max() {
  return context.movingContext.physicalContext.sizeMax;
}



PhysicalP IceBolt::create(void *,WorldP,LocatorP,const Pos &) {
  assert(0);
  return NULL;
}



ShotXdata IceBolt::xdata;

