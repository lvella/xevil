// "railgun.bitmaps"  A Railgun.  A Gun firing a single, very fast, very
// heavy Rail slug that pierces every Creature in its path -- see
// Railgun::create_shot() and Rail::collide() in actual.cpp.


#if X11
#include "gen_xpm/railgun/railgun_4.xpm"
#endif



Size Railgun::get_size_max() {
  return context.weaponContext.itemContext.fallingContext.movingContext.sizes[CO_air];
}



PhysicalP Railgun::create(void *,WorldP w,LocatorP l,const Pos &pos) {
  PhysicalP ret = new Railgun(w,l,pos);
  assert(ret);
  return ret;
}



static void railgun_get_item_info(Boolean &isItem,Boolean &isWeapon,
                                  CMN_BITS_ID &iconId) {
  isItem = True;
  isWeapon = True;
#if WIN32
  iconId = IDB_HIRAILGUN;
#endif
#if X11
  iconId = 0;
#endif
}



GunXdata Railgun::xdata;



const GunContext Railgun::context =
{ /** GunContext **/
  35, /* shotTime */
  5, /* ammoInitial */
  10, /* ammoMax */

  { /** WeaponContext **/
    SoundNames::LASER,

    { /** ItemContext **/
      True, /* persists */
      8000, /* coolness */
      0, /*item use sound */
      { /** FallingContext **/
        {/** MovingContext **/
#if X11
          "black",False,
          Xvars_BACKGROUND,True,
#endif
#if WIN32
          RGB(0,0,0)/*"black"*/,False,
          Xvars_BACKGROUND,True,
#endif

          /* animMax */
          {0,0,0,0,1},

          /* sizes */
          {{0,0},{0,0},{0,0},{0,0},{10,9},},

          /* offsets */
          {{0}},

          /* pixmapBits */
          {{0},{0},{0},{0},{CMN_ID(railgun_4,IDB_HIRAILGUN)}},

          /* maskBits */
          {{0}},

          { /** PhysicalContext **/
            5, /* health */
            9, /* mass */
            A_Railgun, /* classId */
            "railgun", /* className */

            False, /* transmogifyTarget */
            False, /* doppelUser */
            False, /* potentialHuman */
            False, /* potentialEnemy */
            0, /* enemyWeight */
            True, /* potentialWeapon */
            False, /* potentialOtherItem */
            0.0002f, /* objectWorldPercent */
            0, /* levelMaxTimes */
            {10,9}, /* sizeMax */
            Railgun::create, /* create */
            False, /* statsCreations */
            False, /* statsUses */
            False, /* statsDeaths */
            NULL, /* get_stats */
            NULL, /* arg */
            Railgun::init_x, /* init_x */
            Railgun::create_from_stream, /* create_from_stream */
            railgun_get_item_info, /* get_item_info */
          },
          True, /* hiRes */
          0, /* offsetGenerator */
          0, /* transformOverride */
          True, /* useXPM */
        },
      },
    },
  },
};
