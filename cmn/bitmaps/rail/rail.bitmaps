// "rail.bitmaps"  The piercing rail slug fired by the Railgun.  A recolor of
// the Laser beam (white/blue).  Unlike a Laser it does not die when it hits a
// Creature -- see Rail::collide() in actual.cpp -- so it punches straight
// through everything until it hits a wall.


#if X11
#include "gen_xpm/rail/rail_25.xpm"
#include "gen_xpm/rail/rail_28.xpm"
#endif



Size Rail::get_size(Dir dir) {
  return context.movingContext.sizes[dir];
}



Size Rail::get_size_max() {
  return context.movingContext.physicalContext.sizeMax;
}



PhysicalP Rail::create(void *,WorldP,LocatorP,const Pos &) {
  assert(0);
  return NULL;
}



ShotXdata Rail::xdata;

