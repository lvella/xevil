/* Windows resource script for the single-file xevil.exe (mingw-w64 windres).
 *
 * The referenced "xevil.ico" is generated at build time by makefile.win from
 * the compiled-in XPM art (../icon_xpm.h) via ImageMagick, and lands next to
 * the object files in BUILD-WIN -- so windres is invoked with `-I BUILD-WIN`.
 * Resource ID 1 (the numerically lowest ICON) becomes the taskbar / Explorer
 * application icon. */

#include <winver.h>

1 ICON "xevil.ico"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    2,5,0,0
  PRODUCTVERSION 2,5,0,0
  FILEFLAGSMASK  0x3fL
  FILEFLAGS      0x0L
  FILEOS         VOS__WINDOWS32
  FILETYPE       VFT_APP
  FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName",      "Steve Hardt and Michael Judge"
      VALUE "FileDescription",  "XEvil 2.5"
      VALUE "FileVersion",      "2.5.0.0"
      VALUE "InternalName",     "xevil"
      VALUE "LegalCopyright",   "Copyright (C) 1994-2000 Steve Hardt and Michael Judge.  GPLv2."
      VALUE "OriginalFilename", "xevil.exe"
      VALUE "ProductName",      "XEvil"
      VALUE "ProductVersion",   "2.5.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
